{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/prettier.mjs" },
					{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eslint.mjs" }
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/changeset.mjs" },
					{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck.mjs", "timeout": 600 }
				]
			}
		]
	}
}
