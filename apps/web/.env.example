# Variables of the web app, as declared in env.ts.
#
# Copy this file to `.env` and fill in what the deployment needs; every variable has a default, so the smallest
# working copy is an empty `.env`. Any variable can also be read from a file by setting `<NAME>_FILE` to the file's
# path — that is how secrets are mounted on platforms that inject files.

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Console style of the logger: pretty | raw. Unset, JSON lines in production and pretty lines elsewhere.
# LOG_STYLE=pretty

# The Redis server; unset, every subsystem runs on its in-process driver.
# REDIS=redis://localhost:6379

# Prefix of the BullMQ keys, so several projects can share a Redis.
QUEUE_PREFIX=novastarter

# The PostgreSQL connection string; unset, the app runs on PGlite in-process under DATABASE_PGLITE_DIR.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Directory of the in-process PGlite database (relative to the working directory), or memory:// for one that
# lives as long as the process.
DATABASE_PGLITE_DIR=./data/pglite

# Apply the pending migrations of drizzle/ when the server starts: true | 1 | yes | on.
DATABASE_MIGRATE=false

# Which driver carries DATABASE_URL: postgres | supabase | neon | neon-http
DATABASE_DRIVER=postgres

# PEM of the Supabase root certificate, for DATABASE_DRIVER=supabase. Long values belong in a file mounted as
# DATABASE_SSL_CA_FILE.
# DATABASE_SSL_CA=

# Directory of the local storage location.
STORAGE_LOCAL_ROOT=./uploads

# Sender of every message without a from of its own.
MAIL_FROM=noreply@localhost
