{
	"name": "@novastarter/logger",
	"version": "0.0.1",
	"description": "Structured logging for Novastarter",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/logger"
	},
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"dev": "tsdown src/index.ts --dts --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@novastarter/constants": "workspace:*",
		"@novastarter/env": "workspace:*",
		"@novastarter/memory": "workspace:*",
		"@novastarter/utils": "workspace:*",
		"lodash-es": "catalog:",
		"nanoid": "catalog:",
		"pino": "catalog:",
		"pino-http": "catalog:",
		"pino-http-print": "catalog:",
		"pino-pretty": "catalog:"
	},
	"devDependencies": {
		"@novastarter/tsconfig": "workspace:*",
		"@types/lodash-es": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
