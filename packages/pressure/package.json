{
	"name": "@novastarter/pressure",
	"version": "0.0.1",
	"description": "Event loop and memory pressure monitor, with an Express middleware that sheds load",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/pressure"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"dev": "tsdown src/index.ts --dts --watch",
		"check-types": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@novastarter/utils": "workspace:*"
	},
	"peerDependencies": {
		"express": "catalog:"
	},
	"peerDependenciesMeta": {
		"express": {
			"optional": true
		}
	},
	"devDependencies": {
		"@novastarter/tsconfig": "workspace:*",
		"@types/express": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"express": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
