{
	"name": "@novastarter/queue",
	"version": "0.0.1",
	"description": "Background jobs for Novastarter: contracts, a client to enqueue them, drivers that run them",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/queue"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"dev": "tsdown src/index.ts --dts --watch",
		"check-types": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@novastarter/emitter": "workspace:*",
		"@novastarter/errors": "workspace:*",
		"@novastarter/logger": "workspace:*",
		"@novastarter/memory": "workspace:*",
		"@novastarter/redis": "workspace:*",
		"@novastarter/utils": "workspace:*",
		"@novastarter/validation": "workspace:*",
		"croner": "catalog:",
		"ioredis": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"bullmq": "catalog:"
	},
	"peerDependenciesMeta": {
		"bullmq": {
			"optional": true
		}
	},
	"devDependencies": {
		"@novastarter/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"bullmq": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
