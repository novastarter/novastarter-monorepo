{
	"name": "@novastarter/release-notes-generator",
	"version": "0.0.1",
	"description": "Release notes generator for changesets, tailored to the Nova monorepo",
	"keywords": [
		"changesets",
		"changelog",
		"release",
		"release-notes",
		"monorepo",
		"pnpm"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/release-notes-generator"
	},
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"dev": "tsdown src/index.ts --dts --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@pnpm/logger": "catalog:",
		"@pnpm/types": "catalog:",
		"@pnpm/workspace.pkgs-graph": "catalog:",
		"js-yaml": "catalog:",
		"semver": "catalog:"
	},
	"devDependencies": {
		"@changesets/types": "catalog:",
		"@novastarter/tsconfig": "workspace:*",
		"@types/js-yaml": "catalog:",
		"@types/node": "catalog:",
		"@types/semver": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
