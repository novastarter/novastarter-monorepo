{
	"name": "@novastarter/storage-driver-cloudinary",
	"version": "0.0.1",
	"description": "Cloudinary storage driver for `@novastarter/storage`",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/storage-driver-cloudinary"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"dev": "tsdown src/index.ts --dts --watch",
		"check-types": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@novastarter/errors": "workspace:*",
		"@novastarter/storage": "workspace:*",
		"@novastarter/utils": "workspace:*",
		"p-queue": "catalog:",
		"undici": "catalog:"
	},
	"devDependencies": {
		"@ngneat/falso": "catalog:",
		"@novastarter/tsconfig": "workspace:*",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
