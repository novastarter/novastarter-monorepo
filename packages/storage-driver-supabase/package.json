{
	"name": "@novastarter/storage-driver-supabase",
	"version": "0.0.1",
	"description": "Supabase file storage driver for `@novastarter/storage`",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/storage-driver-supabase"
	},
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"dev": "tsdown src/index.ts --dts --watch",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@novastarter/storage": "workspace:*",
		"@novastarter/utils": "workspace:*",
		"@supabase/storage-js": "catalog:",
		"tus-js-client": "catalog:",
		"undici": "catalog:"
	},
	"devDependencies": {
		"@ngneat/falso": "catalog:",
		"@novastarter/tsconfig": "workspace:*",
		"@novastarter/types": "workspace:*",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
