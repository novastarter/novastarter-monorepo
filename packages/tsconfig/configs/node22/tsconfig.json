{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node.js 24",
	"extends": "../base/tsconfig.json",
	"compilerOptions": {
		// Node.js 24 runs ES2024 syntax natively and ships the ES2024 standard library, matching the `engines.node`
		// floor of the monorepo; the `node22` export name is kept so the tsconfigs extending it keep resolving
		"target": "ES2024",
		"lib": ["ES2024"],

		// Node's own ESM/CJS resolution rules: `exports` maps and explicit file extensions in relative imports
		"module": "Node16",
		"moduleResolution": "Node16",

		// Packages are TypeScript-only; the base `checkJs` is switched off because there is no JS to check
		"allowJs": false,
		"checkJs": false,

		// Every export must be explicitly typed, so `.d.ts` files can be generated without running the type-checker
		"isolatedDeclarations": true,

		// Keep `import type` separate from value imports, so bundlers can drop type-only imports safely
		"verbatimModuleSyntax": true
	}
}
