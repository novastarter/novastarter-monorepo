{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node.js 22",
	"extends": "../base/tsconfig.json",
	"compilerOptions": {
		// Node.js 22 runs ES2022 syntax natively and ships the ES2023 standard library
		"target": "ES2022",
		"lib": ["ES2023"],

		// Node's own ESM/CJS resolution rules: `exports` maps and explicit file extensions in relative imports
		"module": "Node16",
		"moduleResolution": "Node16",

		// Packages are TypeScript-only; the base `checkJs` is switched off because there is no JS to check
		"allowJs": false,
		"checkJs": false,

		// Every export must be explicitly typed, so `.d.ts` files can be generated without running the type-checker
		"isolatedDeclarations": true,

		// Keep `import type` separate from value imports, so bundlers can drop type-only imports safely
		"verbatimModuleSyntax": true
	}
}
