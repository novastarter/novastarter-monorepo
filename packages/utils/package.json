{
	"name": "@novastarter/utils",
	"version": "0.2.0",
	"description": "Utilities shared between the Nova packages",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/utils"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/shared/index.js",
		"./node": "./dist/node/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/shared/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "pnpm run '/^build:.*/'",
		"build:shared": "tsdown shared/index.ts --tsconfig shared/tsconfig.json --out-dir dist/shared --dts",
		"build:node": "tsdown node/index.ts --tsconfig node/tsconfig.json --out-dir dist/node --dts",
		"dev": "pnpm run '/^build:.*/' --watch",
		"check-types": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p node/tsconfig.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"js-yaml": "catalog:"
	},
	"devDependencies": {
		"@novastarter/tsconfig": "workspace:*",
		"@types/js-yaml": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
