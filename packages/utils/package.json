{
	"name": "@novastarter/utils",
	"version": "0.3.0",
	"description": "Utilities shared between the Novastarter packages",
	"repository": {
		"type": "git",
		"url": "https://github.com/novastarter/novastarter-monorepo.git",
		"directory": "packages/utils"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./node": "./dist/node/index.js",
		"./package.json": "./package.json"
	},
	"main": "dist/index.js",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsdown src/index.ts src/node/index.ts --dts",
		"dev": "tsdown src/index.ts src/node/index.ts --dts --watch",
		"check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.shared.json",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"js-yaml": "catalog:"
	},
	"devDependencies": {
		"@novastarter/tsconfig": "workspace:*",
		"@types/js-yaml": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
