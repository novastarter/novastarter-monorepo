{
	"extends": "@novastarter/tsconfig/node22",
	"compilerOptions": {
		// No `@types/node` and no `DOM` lib: the shared entry point has to compile on every runtime, so a platform
		// global slipping in fails here. The few host globals it does use are declared in `shared-globals.d.ts`
		"types": []
	},
	"include": ["src", "shared-globals.d.ts"],
	"exclude": ["src/node"]
}
